{
  "recipe": 1,
  "name": "notebook",
  "card": {
    "code": "S-E-C-U",
    "family": "Solve",
    "fit": "yes",
    "clock": "s",
    "proxy": "a local notebook server that starts the same every time",
    "scarce_commit": "DELETE_NOTE, capped at 2 uses",
    "hypothesis": "the template world; it shows the protocol, not a weakness of any agent"
  },
  "world": {
    "mode": "service",
    "actions": ["ADD_NOTE", "LIST_NOTES", "DELETE_NOTE"],
    "timeout_seconds": 20,
    "win": {
      "all": [
        {"path": "dashboard.count", "op": "==", "value": 3},
        {"path": "dashboard.groceries", "op": "==", "value": true}
      ]
    }
  },
  "service": {
    "backend": "mcp",
    "mcp": {"command": ["{python}", "{recipe}/notes_server.py", "--seed", "{seed}"]},
    "actions": {
      "ADD_NOTE": {"tool": "add_note", "arguments": "flat"},
      "LIST_NOTES": {"tool": "list_notes", "arguments": "none"},
      "DELETE_NOTE": {"tool": "delete_note", "arguments": "flat"}
    },
    "dashboard": [
      {"name": "count", "call": {"tool": "count_notes"}, "select": "count"},
      {"name": "groceries", "call": {"tool": "find_note", "arguments": {"title": "groceries"}}, "select": "found"}
    ],
    "caps": {"DELETE_NOTE": 2},
    "replayable": true,
    "reset": "restart"
  },
  "player": {
    "note": "The notebook's answers arrive in the observation's response, and each full answer is saved in the file response.saved names."
  }
}
