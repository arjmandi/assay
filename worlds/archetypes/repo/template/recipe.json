{
  "recipe": 1,
  "name": "repo-tests",
  "card": {
    "code": "M-E-C-0",
    "family": "Solve",
    "fit": "yes",
    "clock": "s",
    "proxy": "a copy of the repository in work/",
    "scarce_commit": null,
    "hypothesis": "the template world; it shows the protocol, not a weakness of any agent"
  },
  "world": {
    "mode": "worktree",
    "source": "example_project",
    "observe": ["{python}", "{archetypes}/repo/repo_world.py", "observe", "--recipe", "{recipe}", "--workdir", "{workdir}", "--state", "{state}"],
    "act": ["{python}", "{archetypes}/repo/repo_world.py", "act", "{action}", "--recipe", "{recipe}", "--workdir", "{workdir}", "--state", "{state}"],
    "actions": ["RUN_TESTS"],
    "timeout_seconds": 660,
    "win": {
      "all": [
        {"path": "selector", "op": "==", "value": "check_calc.py"},
        {"path": "runs", "op": ">=", "value": 1},
        {"path": "failed_runs", "op": "==", "value": 0}
      ]
    }
  },
  "tests": {
    "command": ["{python}", "-m", "pytest", "-q", "-p", "no:cacheprovider", "--junitxml", "{junit}", "{selector}"],
    "timeout_seconds": 120,
    "max_repeat": 5
  },
  "player": {
    "note": "The repository is in work/ in your run directory. Read and edit its files freely; run its tests only through assay act RUN_TESTS, never directly."
  }
}
