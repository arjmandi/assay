__pycache__/
*.pyc
.pytest_cache/
# Hypothesis keeps its character tables and mined constants here; the example database is off.
.hypothesis/
.DS_Store
.venv/
.scratch/
*.egg-info/
dist/
build/
# Run state must never be committed into the repository.
.assay/
# uv run writes a lock file beside pyproject; the release pins nothing beyond pyproject.
uv.lock
# The evaluation runner's default state directory (runs, tokens, ledgers, results).
eval-state/
# The control arms' manuals, fetched by the operator (bench/arcagi/jobs/README.md).
bench/*/jobs/manuals/*
!bench/*/jobs/manuals/README.md
