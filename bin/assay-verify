#!/usr/bin/env bash
set -euo pipefail

# Standalone journal verifier: stdlib only, no dependency on the rest of
# this repo. Any Python 3.9+ on PATH works; unlike bin/assay there is no
# private runtime to provision because there is nothing to install.
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$repo_dir/verify/assay_verify.py" "$@"
fi

echo "assay-verify requires a python3 on PATH" >&2
exit 127
