#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
export MPLCONFIGDIR="${TMPDIR:-/tmp}/assay-runtime-${UID:-0}/matplotlib"
export UV_CACHE_DIR="${TMPDIR:-/tmp}/assay-runtime-${UID:-0}/uv-cache"
export UV_NO_PROGRESS=1
mkdir -p "$MPLCONFIGDIR" "$UV_CACHE_DIR"

compatible='import sys; assert sys.version_info >= (3, 12); import numpy, PIL; assert 2 <= int(numpy.__version__.split(".")[0]) < 3; assert 10 <= int(PIL.__version__.split(".")[0]) < 13'

# 1. ASSAY_PYTHON pins the interpreter: the one whose site-packages hold the
#    adapter's dependencies (a benchmark venv). The daemon inherits it. A pin
#    that fails the fingerprint is an error, never a silent fallback.
if [[ -n "${ASSAY_PYTHON:-}" ]]; then
  if "$ASSAY_PYTHON" -c "$compatible" >/dev/null 2>&1; then
    exec "$ASSAY_PYTHON" "$repo_dir/src/assay_cli.py" "$@"
  fi
  echo "assay: ASSAY_PYTHON=$ASSAY_PYTHON is not a Python 3.12+ with numpy 2.x and pillow 10 to 12; fix it or unset ASSAY_PYTHON" >&2
  exit 126
fi

# 2. The first python3 on PATH, when it already fits.
if command -v python3 >/dev/null 2>&1 && python3 -c "$compatible" >/dev/null 2>&1; then
  exec python3 "$repo_dir/src/assay_cli.py" "$@"
fi

# 3. No usable python3 at all: uv resolves the inline script metadata.
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; assert sys.version_info >= (3, 12)' >/dev/null 2>&1; then
  if command -v uv >/dev/null 2>&1; then
    exec uv run --quiet --python '>=3.12' --script "$repo_dir/src/assay_cli.py" "$@"
  fi
  echo "assay requires Python 3.12+ or uv; neither usable runtime was found (ASSAY_PYTHON can name one)" >&2
  exit 127
fi

# 4. A python3 >= 3.12 without numpy or pillow: a private runtime under the
#    temp directory, built once. It never holds adapter dependencies; for a
#    benchmark world install the package (pip install -e .) into a venv and
#    point ASSAY_PYTHON at it.
python_tag="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
runtime_root="${TMPDIR:-/tmp}/assay-runtime-${UID:-0}/python-v1-${python_tag}"
managed_python="$runtime_root/bin/python"
if [[ ! -x "$managed_python" ]]; then
  mkdir -p "$(dirname "$runtime_root")"
  lock_dir="${runtime_root}.lock"
  attempts=0
  until mkdir "$lock_dir" 2>/dev/null; do
    attempts=$((attempts + 1))
    if [[ $attempts -ge 600 ]]; then
      echo "assay timed out waiting for its runtime setup lock: $lock_dir" >&2
      exit 126
    fi
    sleep 0.1
  done
  trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT
  if [[ ! -x "$managed_python" ]]; then
    echo "assay: preparing its private runtime (first use only)" >&2
    python3 -m venv "$runtime_root"
    "$managed_python" -m pip install --disable-pip-version-check --quiet \
      'numpy>=2,<3' 'pillow>=10,<13'
  fi
  rmdir "$lock_dir"
  trap - EXIT
fi

if ! "$managed_python" -c "$compatible" >/dev/null 2>&1; then
  echo "assay managed runtime failed its dependency fingerprint" >&2
  exit 126
fi
exec "$managed_python" "$repo_dir/src/assay_cli.py" "$@"
