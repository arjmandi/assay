#!/usr/bin/env bash
# The launcher: runs the kernel from this checkout, no install needed.
# ASSAY_PYTHON pins the interpreter (the one that holds an adapter's own
# dependencies); otherwise the first python3 with numpy runs it, else uv.
set -euo pipefail

src="$(cd "$(dirname "$0")/.." && pwd)/src"
fits='import sys; assert sys.version_info >= (3, 12); import numpy'

python="${ASSAY_PYTHON:-python3}"
if "$python" -c "$fits" >/dev/null 2>&1; then
  PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}" exec "$python" -m assay.cli "$@"
fi
if [[ -z "${ASSAY_PYTHON:-}" ]] && command -v uv >/dev/null 2>&1; then
  PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}" exec uv run --quiet --python '>=3.12' \
    --with 'numpy>=2,<3' --with 'pillow>=10' python -m assay.cli "$@"
fi
echo "assay: $python is not a Python 3.12+ with numpy; set ASSAY_PYTHON to one that is, or install uv" >&2
exit 127
