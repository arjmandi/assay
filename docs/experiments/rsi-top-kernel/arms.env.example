# Copy to arms.env (not committed) and fill in. kernel_exp.sh reads it.

# Where runs, baselines and results live: outside the repository.
KERNEL_EXP="$HOME/assay/experiments/rsi-top-kernel"

# Model ids as each tool names them. Decided 2026-11-17: the G arms and A1 run
# Gemini 3.7 Flash, the model the published numbers were made with. The page gives
# no API id and the wrapper's code only knows gemini-3.1-pro-preview, so fill in
# the two ids from the provider's model list on the run machine (CHECKS.md).
WRAPPER_GEMINI_MODEL="FILL_IN_gemini_3_7_flash_id"
WRAPPER_DEEPSEEK_MODEL="deepseek-v4-flash"
OPENCODE_GEMINI_MODEL="google/FILL_IN_gemini_3_7_flash_id"
OPENCODE_DEEPSEEK_MODEL="deepseek/deepseek-v4-flash"
CLAUDE_OPUS_MODEL="claude-opus-5-5"

# The caps of the study.
HOURS=12
BUDGET_USD=400
MAX_SESSIONS=500

# Keys: export them in the shell that runs kernel_exp.sh, never write them here.
#   GEMINI_API_KEY, DEEPSEEK_API_KEY   the baselines and, through OpenCode, A1 and A2
#   GOOGLE_GENERATIVE_AI_API_KEY       the name OpenCode's google provider reads
#   OPENROUTER_API_KEY                 ShinkaEvolve's embeddings (SH-G, SH-D)
